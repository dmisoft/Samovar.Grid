@page "/auto-columns"

@inject WeatherForecastService ForecastService
@inject IJSRuntime JS

<h1>Auto-Generated Columns</h1>

<SmGrid Data=forecasts AutoGenerateColumns=true />

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Excluding properties from auto-generation</h5>
        <p>Use <code class="language-csharp">[Browsable(false)]</code> to exclude a property from auto-generated columns:</p>
        <pre><code class="language-csharp">using System.ComponentModel;

public class MyModel
{
    public string Name { get; set; }          // visible as column

    [Browsable(false)]
    public string InternalId { get; set; }    // excluded from grid
}</code></pre>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Customizing column titles</h5>
        <p>Use <code class="language-csharp">[DisplayName]</code> or <code class="language-csharp">[Display(Name=...)]</code> to set custom column headers:</p>
        <pre><code class="language-csharp">using System.ComponentModel;
using System.ComponentModel.DataAnnotations;

public class MyModel
{
    [DisplayName("Full Name")]
    public string Name { get; set; }              // column title: "Full Name"

    [Display(Name = "Temperature (C)")]
    public int TemperatureC { get; set; }         // column title: "Temperature (C)"

    public string Summary { get; set; }           // column title: "Summary" (property name)
}</code></pre>
    </div>
</div>

@code {
    private List<WeatherForecast>? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = (await ForecastService.GetForecastAsync(DateTime.Now)).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("hljs.highlightAll");
        }
    }
}

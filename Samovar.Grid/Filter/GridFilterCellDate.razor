@using System.Globalization
@inherits GridFilterCellBase<DateTime?>
<th style="@WidthStyle" class="px-1" id="@(((IDataColumnModel)ColMetadata).FilterCellId)" data-toggle="tooltip" data-placement="top" title="@(((IDataColumnModel)ColMetadata).Title.Value)">

<div class="d-flex flex-row">
    <div class="sm-filter-cell-wrapper">
        <input style="min-width:10px;" type="date" class="form-control sm-filter-cell-input @_inputSizeClass" @bind="InnerValue" @bind:event="onchange" @bind:format="yyyy-MM-dd" />
        <button type="button" class="sm-filter-cell-clear-btn @_clearBtnSizeClass" tabindex="-1" @onmousedown:preventDefault @onclick="ResetValue">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
            </svg>
        </button>
    </div>
</div>
</th>

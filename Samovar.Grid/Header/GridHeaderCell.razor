@using System.Globalization

@inherits DesignComponentBase

<th style="@(WidthStyle + "padding-right:0;min-width:50px;vertical-align:middle;")" id="@(ColumnModel.HeaderCellId)"
	data-toggle="tooltip" data-placement="top" title="@(ColumnModel.Title.Value)">
	<div class="d-flex" style="margin:0 0 0 4px;padding:0px;">
		<div @onmouseup=ColumnCellMouseUp @onmousedown=ColumnCellMouseDown @onclick=ColumnCellClick
			 style="flex-grow:1;text-overflow:ellipsis;overflow:hidden;white-space: nowrap;cursor:pointer;display:block;"
			 dropzone="DropZoneGridHeader" draggable=@ColumnCellDraggable ondragover="event.preventDefault()">
			@(ColumnModel.Title.Value)
		</div>
		@if (SortDirection == SortDir.Asc)
		{
			<div style="margin:0 4px 0 0;padding:0px;">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-sort-alpha-up flex-shrink-0 align-self-center" viewBox="0 0 16 16">
					<path fill-rule="evenodd" d="M10.082 5.629 9.664 7H8.598l1.789-5.332h1.234L13.402 7h-1.12l-.419-1.371zm1.57-.785L11 2.687h-.047l-.652 2.157z"/>
					<path d="M12.96 14H9.028v-.691l2.579-3.72v-.054H9.098v-.867h3.785v.691l-2.567 3.72v.054h2.645zm-8.46-.5a.5.5 0 0 1-1 0V3.707L2.354 4.854a.5.5 0 1 1-.708-.708l2-1.999.007-.007a.5.5 0 0 1 .7.006l2 2a.5.5 0 1 1-.707.708L4.5 3.707z"/>
				</svg>
			</div>
		}
		else if (SortDirection == SortDir.Desc)
		{
			<div style="margin:0 4px 0 0;padding:0px;">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-sort-alpha-down-alt flex-shrink-0 align-self-center" viewBox="0 0 16 16">
				<path d="M12.96 7H9.028v-.691l2.579-3.72v-.054H9.098v-.867h3.785v.691l-2.567 3.72v.054h2.645z"/>
				<path fill-rule="evenodd" d="M10.082 12.629 9.664 14H8.598l1.789-5.332h1.234L13.402 14h-1.12l-.419-1.371zm1.57-.785L11 9.688h-.047l-.652 2.156z"/>
				<path d="M4.5 2.5a.5.5 0 0 0-1 0v9.793l-1.146-1.147a.5.5 0 0 0-.708.708l2 1.999.007.007a.497.497 0 0 0 .7-.006l2-2a.5.5 0 0 0-.707-.708L4.5 12.293z"/>
			</svg>
			</div>
		}
		@if (LayoutService.ColumnResizeMode.Value != GridColumnResizeMode.Disabled && !IsLastColumn)
		{
			if (ColumnModel.Resizable)
			{
				<div class="sm-column-grip sm-column-grip-resizable"
					 @onmousedown="((args) => OnMouseDown(args, ColumnModel))"
					 draggable="false" ondrag="event.stopPropagation()" ondragover="event.stopPropagation()"></div>
			}
			else
			{
				<div class="sm-column-grip"></div>
			}
		}
	</div>
</th>
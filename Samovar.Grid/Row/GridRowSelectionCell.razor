@namespace Samovar.Grid
@typeparam T
@inherits DesignComponentBase

<td style="@(WidthStyle + "text-align:center;vertical-align:middle;")"
    @onmousedown="() => { }" @onmousedown:stopPropagation>
    <input class="form-check-input" type="checkbox" checked="@RowModel.IsRowSelected"
           @onchange="() => GridSelectionService.OnRowChecked(RowModel.DataItem!)"
           @onclick:stopPropagation />
</td>

@typeparam TItem
@inherits DesignComponentBase

<!-- Modal -->
<div style="display:block;" class="modal" @ref=Ref id=@Id data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content" style="resize:both;overflow: auto;">
			<div class="modal-header" id=@($"{Id}header") style="cursor: move;">
				@if (TemplateService.EditPopupTitleTemplate.Value is not null) {
					@TemplateService.EditPopupTitleTemplate.Value(RowModel.DataItem)
				}
				else
				{
					<h5 class="modal-title @_titleSizeClass" id="staticBackdropLabel">@L10n[LocalizationKeys.EditPopupTitleEdit]</h5>
				}
				
				<button type="button" class="btn-close" aria-label="@L10n[LocalizationKeys.EditCloseAriaLabel]" @onclick="@(() => EditingService.CancelRowEdit(RowModel))"></button>
			</div>
			<div class="modal-body">
				<GridRowEditing_Body RowModel=RowModel />
			</div>
			<div class="modal-footer">
				<button class="btn btn-outline-primary mx-1 @_btnSizeClass" @onclick=@(() => EditingService.EditCommit(RowModel))>@L10n[LocalizationKeys.EditUpdate]</button>
				<button class="btn btn-outline-secondary mx-1 @_btnSizeClass" @onclick=@(() => EditingService.CancelRowEdit(RowModel))>@L10n[LocalizationKeys.EditCancel]</button>
			</div>
		</div>
	</div>
</div>
<div class="modal-backdrop fade show"></div>
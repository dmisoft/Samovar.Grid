@using System.Globalization
@inherits DesignComponentBase

<thead style="visibility:hidden;">
	<tr style="height:0px !important;">
		@{
			@if (GridLayoutService.ShowRowSelectionColumn.Value)
			{
				<GridHiddenHeaderCheckboxCell />
			}
			@if (GridLayoutService.ShowDetailRow.Value)
			{
				<GridHiddenHeaderDetailExpanderCell />
			}
			@for (int i = 0; i < GridLayoutService.ActiveGroupCount.Value; i++)
			{
				<GridHiddenGroupIndentCell />
			}

			foreach (var colMeta in GridColumnService.AllColumnModels)
			{
				if (colMeta is IDataColumnModel dc && dc.GroupIndex.Value.HasValue)
					continue; // grouped columns are hidden
				<GridHiddenHeaderCell ColumnModel=@colMeta />
			}

			<th style="padding-right:0;border-bottom-width:0px;border-top-width:0px;"
				id="@(GridColumnService.EmptyColumnModel.HiddenHeaderCellId)" class="sm-th-hidden p-0"></th>
		}
	</tr>
</thead>
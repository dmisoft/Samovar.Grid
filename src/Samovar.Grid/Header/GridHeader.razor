@using System.Globalization
@typeparam T
@inherits DesignComponentBase

<div style="position:relative;display:flex;flex-direction:row;@(LayoutService.HeaderReady.Value ? "" : "visibility:hidden;")">
    <div style="overflow:hidden;position:relative;flex-grow:1;" id="@ConstantService.GridHeaderContainerId">
        <div style="position:relative;">
            <table style="margin:0;padding:0;table-layout:fixed;@(LayoutService.MinGridWidth.Value > 0 ? "min-width:" + LayoutService.MinGridWidth.Value.ToString(CultureInfo.InvariantCulture) + "px;" : "")" class="@CssClass @_tableSizeClass">
                <thead>
                    <tr>
                        @{
                            @if (LayoutService.ShowRowSelectionColumn.Value)
                            {
                                <GridHeaderRowSelectionCell />
                            }
                            @if (LayoutService.ShowDetailRow.Value)
                            {
                                <GridHeaderDetailExpanderCell />
                            }
                            @for (int i = 0; i < LayoutService.ActiveGroupCount.Value; i++)
                            {
                                <GridGroupIndentHeaderCell />
                            }

                            foreach (var columnModel in GridColumnService.AllColumnModels)
                            {
                                switch (columnModel.ColumnType)
                                {
                                    case ColumnType.Data:
                                    case ColumnType.Expression:
                                        var dataCol = (IDataColumnModel)columnModel;
                                        if (dataCol.GroupIndex.Value.HasValue)
                                            break; // grouped columns are hidden from the header
                                        <GridHeaderCell TItem="T" ColumnModel=@dataCol />
                                        break;
                                    case ColumnType.Command:
                                        <GridHeaderCommandCell ColumnModel=@((ICommandColumnModel)columnModel) T="T" />
                                        break;
                                }
                            }
                            <GridHeaderEmptyCell ColumnModel=@GridColumnService.EmptyColumnModel />
                        }
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@page "/styling"

@inject EmployeeService EmployeeService

<h1>CSS Vars</h1>

<style>
    :root {
        --sm-detail-row-expanded-icon: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 3.5a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1-.5-.5M8 6a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 .708-.708L7.5 12.293V6.5A.5.5 0 0 1 8 6"/></svg>');
        --sm-detail-row-collapsed-icon: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M6 8a.5.5 0 0 0 .5.5h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L12.293 7.5H6.5A.5.5 0 0 0 6 8m-2.5 7a.5.5 0 0 1-.5-.5v-13a.5.5 0 0 1 1 0v13a.5.5 0 0 1-.5.5"/></svg>');
        --sm-row-selected-bg: rgba(69, 46, 222, 0.5);
    }
</style>
<div class="row">
    <div class="col">

        <SmGrid @ref=grid Data="employees"
                CssClass="table-bordered table-sm table-striped"
                PaginationCssClass="pagination-sm"
                FilterMode=GridFilterMode.FilterRow
                DataNavigationMode=NavigationMode.Paging
                SelectionMode=RowSelectionMode.Single
                ShowDetailRow="true"
                ShowCommandBar="true"
                ColumnResizeMode=GridColumnResizeMode.Sliding
                @bind-SingleSelectedDataRow=@selectedRow
                Height="600px">
            <Columns>
                <Column Field="@nameof(Employee.FirstName)" />
                <Column Field="@nameof(Employee.LastName)" />
                <Column Field="@nameof(Employee.Department)" />
                <Column Field="@nameof(Employee.HireDate)" />
                <Column Field="@nameof(Employee.Salary)" />
                <CommandColumn EditButtonVisible=true DeleteButtonVisible=true NewButtonVisible=true Width="150px" />
            </Columns>
            <DetailRowTemplate Context="mydata">
                @{
                    if (mydata is not null)
                    {
                        Employee data = mydata as Employee;
                        <div class="form-group row mb-2">
                            <label class="col-2 col-form-label">Email</label>
                            <div class="col-10">@data.Email</div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-2 col-form-label">Job Title</label>
                            <div class="col-10">@data.JobTitle</div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-2 col-form-label">Phone</label>
                            <div class="col-10">@data.Phone</div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-2 col-form-label">Active</label>
                            <div class="col-10">@data.IsActive</div>
                        </div>
                    }
                }
            </DetailRowTemplate>
        </SmGrid>
    </div>
</div>

@code {
    private List<Employee>? employees;
    SmGrid<Employee?>? grid;
    Employee? selectedRow;

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetEmployeesAsync()).ToList();
    }
}

@page "/filter"

@inject EmployeeService EmployeeService

<h1>Filter</h1>

<div class="form-group row">
    <label for="filterMode" class="col-1 col-form-label m-2">Filter mode:</label>
    <div class="col-2 m-2">
        <select id="filterMode" class="form-select form-select-lg" @bind=filterMode>
            <option value=@GridFilterMode.None>None</option>
            <option value=@GridFilterMode.Custom>Custom</option>
            <option value=@GridFilterMode.FilterRow>FilterRow</option>
            <option value=@GridFilterMode.FilterMenu>FilterMenu</option>
        </select>
    </div>
    <label for="gridSizeMode" class="col-1 col-form-label m-2">Size mode:</label>
    <div class="col-2 m-2">
        <select id="gridSizeMode" class="form-select form-select-lg" @bind=gridSizeMode>
            <option value=@GridSizeMode.Default>Default</option>
            <option value=@GridSizeMode.Small>Small</option>
            <option value=@GridSizeMode.Large>Large</option>
        </select>
    </div>
    @if(filterMode == GridFilterMode.Custom){
        <button class="col-2 btn btn-primary m-3" @onclick="ApplyCustomFilter">Apply custom filter</button>
        <button class="col-2 btn btn-primary m-3" @onclick="ResetCustomFilter">Reset custom filter</button>
    }
</div>

<SmGrid @ref=grid
        Data=employees
        FilterMode=filterMode
        SizeMode=gridSizeMode
        Height="600px">
    <Columns>
        <Column Field="@nameof(Employee.Id)" />
        <Column Field="@nameof(Employee.FirstName)" />
        <Column Field="@nameof(Employee.LastName)" />
        <Column Field="@nameof(Employee.Department)" />
        <Column Field="@nameof(Employee.HireDate)" />
        <Column Field="@nameof(Employee.Salary)" />
        <Column Field="@nameof(Employee.IsActive)" />
        <CommandColumn/>
    </Columns>
</SmGrid>


@code {
    private List<Employee>? employees;
    SmGrid<Employee>? grid;
    GridFilterMode filterMode = GridFilterMode.Custom;
    GridSizeMode gridSizeMode = GridSizeMode.Default;

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetEmployeesAsync()).ToList();
    }

    async Task ApplyCustomFilter()
    {
        Func<Employee, bool> filter = e => e.IsActive;
        await grid!.ApplyCustomFilter(filter);
    }

    async Task ResetCustomFilter()
    {
        await grid!.ResetCustomFilter();
    }
}

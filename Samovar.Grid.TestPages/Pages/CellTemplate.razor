@page "/cell-template"

@inject EmployeeService EmployeeService

<h1>Cell Templates</h1>

<style>
    .high-salary-style {
        color: green;
        font-weight: bold;
    }

    .low-salary-style {
        color: darkorange;
        font-weight: bold;
    }

    .active-style {
        color: green;
    }

    .inactive-style {
        color: red;
    }
</style>

<SmGrid @ref=grid
        Data="employees"
        FilterMode=GridFilterMode.FilterRow
        Height="600px"
        DataNavigationMode=NavigationMode.Paging
        SelectionMode=RowSelectionMode.Multiple>
    <Columns>
        <Column Field="@nameof(Employee.FirstName)" Title="Full Name">
            <CellShowTemplate>
                @{
                    var emp = (context as Employee)!;
                    <div>@($"{emp.FirstName} {emp.LastName}")</div>
                }
            </CellShowTemplate>
        </Column>
        <Column Field="@nameof(Employee.HireDate)" Title="Hire Date">
            <CellShowTemplate>
                @{
                    <div>@($"{(context as Employee)!.HireDate:yyyy-MM-dd}")</div>
                }
            </CellShowTemplate>
        </Column>
        <Column Field="@nameof(Employee.Salary)">
            <CellShowTemplate>
                @{
                    var salary = (context as Employee)!.Salary;
                    if (salary >= 100_000)
                    {
                        <div class="high-salary-style">@($"{salary:C0}")</div>
                    }
                    else
                    {
                        <div class="low-salary-style">@($"{salary:C0}")</div>
                    }
                }
            </CellShowTemplate>
        </Column>
        <Column Field="@nameof(Employee.IsActive)" Title="Is active">
            <CellShowTemplate>
                @{
                    var isActive = (context as Employee)!.IsActive;
                    if (isActive)
                    {
                        <div class="active-style">Active</div>
                    }
                    else
                    {
                        <div class="inactive-style">Inactive</div>
                    }
                }
            </CellShowTemplate>
        </Column>
    </Columns>
</SmGrid>


@code {
    private List<Employee>? employees;
    SmGrid<Employee>? grid;

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetEmployeesAsync()).ToList();
    }
}

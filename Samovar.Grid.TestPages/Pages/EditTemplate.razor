@page "/edit-template"

@using System.ComponentModel.DataAnnotations

@inject EmployeeService EmployeeService

<h1>Insert / Edit Templates</h1>

<div class="form-group row align-items-center mb-3">
    <label for="gridEditMode" class="form-label col-1">Grid edit mode</label>
    <div class="col-1">
        <select id="gridEditMode" class="col-10 form-select form-select-lg" @bind=gridEditMode>
            <option value=@GridEditMode.None>None</option>
            <option value=@GridEditMode.Form>Form</option>
            <option value=@GridEditMode.Popup>Popup</option>
        </select>
    </div>
</div>
    <div class="row">
        <div class="col">

<SmGrid @ref=grid
        Data="employees"
        FilterMode=GridFilterMode.FilterRow
        Height="600px"
        RowEditBegin="@((Employee data) => RowEditBeginHandler(data))"
        RowInsertBegin=@RowInsertBeginHandler
        EditMode=@gridEditMode
        DataNavigationMode=NavigationMode.Paging
        SelectionMode=RowSelectionMode.Multiple>
    <Columns>
        <CommandColumn EditButtonVisible=true NewButtonVisible=true DeleteButtonVisible=false Width="150px" />
        <Column Title="First Name" Field="@nameof(Employee.FirstName)">
            <CellShowTemplate>
                @{
                    Employee? data = context as Employee;
                    if (data is not null)
                    {
                        <div style="white-space:break-spaces">@($"{data.FirstName} {data.LastName}")</div>
                    }
                    else
                    {
                        <div></div>
                    }
                }
            </CellShowTemplate>
        </Column>
        <Column Title="Job Title" Field="@nameof(Employee.JobTitle)" />
        <Column Title="Department" Field="@nameof(Employee.Department)" />
        <Column Title="Salary" Field="@nameof(Employee.Salary)" />
    </Columns>
    <EditFormTemplate>
        <EditForm Model="@EditContext" Context="EditFormContext" OnValidSubmit=HandleValidCustomEditSubmit>
            <DataAnnotationsValidator />
            <div class="form-group row mb-2">
                <label class="col-2 col-form-label" for="firstName">First Name</label>
                <div class="col-10">
                    <InputText class="form-control" id="firstName" @bind-Value="EditContext!.FirstName" />
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-2 col-form-label" for="lastName">Last Name</label>
                <div class="col-10">
                    <InputText class="form-control" id="lastName" @bind-Value="EditContext.LastName" />
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-2 col-form-label" for="salary">Salary</label>
                <div class="col-10">
                    <InputNumber class="form-control" id="salary" TValue="decimal" @bind-Value="EditContext.Salary" />
                </div>
            </div>
            <div class="row mb-2">
                <ValidationSummary />
            </div>
            <div class="row">
                <div class="col s-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary mx-1">update</button>
                    <button type="button" class="btn btn-outline-secondary mx-1" @onclick="HandleCancelCustomEdit">cancel</button>
                </div>
            </div>
        </EditForm>
    </EditFormTemplate>
    <InsertFormTemplate>
        <EditForm Model="@InsertContext" Context="EditFormContext" OnValidSubmit=HandleValidInsertingSubmit>
            <DataAnnotationsValidator />
            <div class="form-group row mb-2">
                <label class="col-2 col-form-label" for="firstName">First Name</label>
                <div class="col-10">
                    <InputText class="form-control" id="firstName" @bind-Value="InsertContext!.FirstName" />
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-2 col-form-label" for="lastName">Last Name</label>
                <div class="col-10">
                    <InputText class="form-control" id="lastName" @bind-Value="InsertContext.LastName" />
                </div>
            </div>
            <div class="form-group row mb-2">
                <label class="col-2 col-form-label" for="salary">Salary</label>
                <div class="col-10">
                    <InputNumber class="form-control" id="salary" TValue="decimal" @bind-Value="InsertContext.Salary" />
                </div>
            </div>
            <div class="form-row">
                <ValidationSummary />
            </div>
            <div class="row">
                <div class="col s-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary mx-1">add</button>
                    <button type="button" class="btn btn-outline-secondary mx-1" @onclick="OnCancelInsertingButtonClick">cancel</button>
                </div>
            </div>
        </EditForm>
    </InsertFormTemplate>
</SmGrid>
</div>
    </div>

@code {
    private List<Employee>? employees;
    FormEditContext? EditContext = null;
    FormInsertContext? InsertContext = null;
    SmGrid<Employee>? grid;

    GridEditMode gridEditMode = GridEditMode.Form;

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetEmployeesAsync(1000)).ToList();
    }

    void RowEditBeginHandler(Employee item)
    {
        EditContext = new FormEditContext(item);
    }

    void RowInsertBeginHandler()
    {
        InsertContext = new FormInsertContext();
    }

    async Task HandleValidCustomEditSubmit()
    {
        EditContext!.DataItem.FirstName = EditContext.FirstName;
        EditContext!.DataItem.LastName = EditContext.LastName;
        EditContext!.DataItem.Salary = EditContext.Salary;
        await grid!.CommitCustomRowEdit(EditContext.DataItem);
    }

    async Task HandleValidInsertingSubmit()
    {
        var newItem = new Employee
            {
                FirstName = InsertContext!.FirstName,
                LastName = InsertContext.LastName,
                Salary = InsertContext.Salary,
                HireDate = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1)
            };

        employees = ((new Employee[] { newItem }).Concat(employees!)).ToList();
        await grid!.CancelRowInsert();
        StateHasChanged();
    }

    async Task HandleCancelCustomEdit()
    {
        await grid!.CancelCustomRowEdit(EditContext!.DataItem);
        EditContext = null;
    }

    async Task OnCancelInsertingButtonClick()
    {
        await grid!.CancelRowInsert();
        EditContext = null;
    }

    class FormEditContext
    {
        public FormEditContext(Employee dataItem)
        {
            DataItem = dataItem;
            FirstName = dataItem.FirstName;
            LastName = dataItem.LastName;
            Salary = dataItem.Salary;
        }

        public Employee DataItem { get; set; }

        [Required]
        [StringLength(maximumLength: 50, MinimumLength = 2, ErrorMessage = "First name should be 2 to 50 characters.")]
        public string FirstName { get; set; }

        [Required]
        [StringLength(maximumLength: 50, MinimumLength = 2, ErrorMessage = "Last name should be 2 to 50 characters.")]
        public string LastName { get; set; }

        [Range(0, 10_000_000, ErrorMessage = "Salary must be a positive value.")]
        public decimal Salary { get; set; }
    }

    internal class FormInsertContext
    {
        internal FormInsertContext()
        {
            FirstName = string.Empty;
            LastName = string.Empty;
        }

        [Required]
        [StringLength(maximumLength: 50, MinimumLength = 2, ErrorMessage = "First name should be 2 to 50 characters.")]
        public string FirstName { get; set; }

        [Required]
        [StringLength(maximumLength: 50, MinimumLength = 2, ErrorMessage = "Last name should be 2 to 50 characters.")]
        public string LastName { get; set; }

        [Range(0, 10_000_000, ErrorMessage = "Salary must be a positive value.")]
        public decimal Salary { get; set; }
    }
}

@page "/"

@inject EmployeeService EmployeeService

<h1>Common tests</h1>
    <div class="row">
        <div class="col-9">
            <SmGrid @ref=@grid
                    ShowColumnHeader="false"
                    Data=@employees
                    SizeMode=@gridSizeMode
                    Height=@gridHeight
                    Width=@gridWidth
                    ShowDetailRow=@showDetailRow
                    ShowCommandBar=@showCommandBar
                    PageSize=@pageSize
                    EditMode=@gridEditMode
                    SelectionMode=@selectionMode
                    ColumnResizeMode=@columnResizeMode
                    @bind-SingleSelectedDataRow=@selectedRow
                    @bind-MultipleSelectedDataRows=@selectedRows
                    RowEditBegin="@((Employee data) => RowEditBeginHandler(data))"
                    RowInserting="@((Employee data) => RowInsertingHandler(data))"
                    RowsRemoving="@((List<Employee> args) => RowsRemovingHandler(args))">
                <Columns>
                    <Column Title="Hire Date" Field="@nameof(Employee.HireDate)" Width="120px" />
                    <Column Title="First Name" Field="@nameof(Employee.FirstName)" Width="130px" TextAlign="@nameAlign" />
                    <Column Title="Last Name" Field="@nameof(Employee.LastName)" Width="130px" TextAlign="@nameAlign" />
                    <Column Title="Job Title" Field="@nameof(Employee.JobTitle)" Width="1*" />
                    <Column Title="Salary" Field="@nameof(Employee.Salary)" Width="110px" TextAlign="GridTextAlign.Right" Format="@salaryFormat" />
                    <CommandColumn EditButtonVisible=true DeleteButtonVisible=true NewButtonVisible=true Width="150px" />
                </Columns>

                <DetailRowTemplate Context="mydata">
                    @{
                        if (mydata is not null)
                        {
                            Employee data = mydata as Employee;
                            <div class="form-group row mb-2">
                                <label class="col-2 col-form-label">Name</label>
                                <div class="col-10">@($"{data.FirstName} {data.LastName}")</div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-2 col-form-label">Email</label>
                                <div class="col-10">@data.Email</div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-2 col-form-label">Department</label>
                                <div class="col-10">@data.Department</div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-2 col-form-label">Phone</label>
                                <div class="col-10">@data.Phone</div>
                            </div>
                        }
                    }
                </DetailRowTemplate>
            </SmGrid>
        </div>
        <div class="col-3">
            <div class="mb-3">
                <label for="pageSize" class="form-label">Page size</label>
                <input type="text" class="form-control" id="pageSize" @bind=pageSize />
            </div>
            <div class="mb-3">
                <label for="columnWidth">Column width</label>
                <input type="text" class="form-control" id="columnWidth" @bind=columnWidth />
            </div>
            <div class="mb-3">
                <label for="salaryFormat" class="form-label">Salary format</label>
                <input type="text" class="form-control" id="salaryFormat" @bind=salaryFormat />
            </div>
            <div class="mb-3">
                <label for="nameAlign" class="form-label">Name column align</label>
                <select id="nameAlign" class="form-select form-select-lg" @bind=nameAlign>
                    <option value=@GridTextAlign.Left>Left</option>
                    <option value=@GridTextAlign.Center>Center</option>
                    <option value=@GridTextAlign.Right>Right</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="gridHeight">Grid height</label>
                <input type="text" class="form-control" id="gridHeight" @bind=gridHeight />
            </div>
            <div class="mb-3">
                <label for="gridWidth">Grid width</label>
                <input type="text" class="form-control" id="gridWidth" @bind=gridWidth />
            </div>
            <div class="mb-3">
                <label for="gridEditMode" class="form-label">Grid edit mode</label>
                <select id="gridEditMode" class="form-select form-select-lg" @bind=gridEditMode>
                    <option value=@GridEditMode.None>None</option>
                    <option value=@GridEditMode.Form>Form</option>
                    <option value=@GridEditMode.Popup>Popup</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="gridSizeMode" class="form-label">Grid size mode</label>
                <select id="gridSizeMode" class="form-select form-select-lg" @bind=gridSizeMode>
                    <option value=@GridSizeMode.Default>Default</option>
                    <option value=@GridSizeMode.Small>Small</option>
                    <option value=@GridSizeMode.Large>Large</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="columnResizeMode" class="form-label">Column resize mode</label>
                <select id="columnResizeMode" class="form-select form-select-lg" @bind=columnResizeMode>
                    <option value=@GridColumnResizeMode.None>None</option>
                    <option value=@GridColumnResizeMode.Sliding>Sliding</option>
                    <option value=@GridColumnResizeMode.Block>Block</option>
                </select>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind=showDetailRow id="showDetailRow">
                    <label class="form-check-label" for="showDetailRow">
                        Show detail row
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind=showCommandBar id="showCommandBar">
                    <label class="form-check-label" for="showCommandBar">
                        Show command bar
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <button class="btn btn-primary" @onclick="collapseAllDetailRows">Collapse all detail rows</button>
            </div>

            <div class="mb-3">
                <label for="rowSelectionMode" class="form-label">Row selection mode</label>
                <select id="rowSelectionMode" class="form-select form-select-lg" @bind=selectionMode>
                    <option value=@RowSelectionMode.None>None</option>
                    <option value=@RowSelectionMode.Single>Single</option>
                    <option value=@RowSelectionMode.Multiple>Multiple</option>
                </select>
            </div>

            @if (selectedRow is not null)
            {
                <div class="mb-3 row">
                    <div class="col-8">@($"{selectedRow.FirstName} {selectedRow.LastName} — {selectedRow.JobTitle}")</div>
                    <div class="col-4">
                        <button class="btn btn-danger mb-3" @onclick="deselectSingleSelectedItem">deselect</button>
                    </div>
                </div>
            }

            @if (selectedRows != null)
            {
                @foreach (var item in selectedRows)
                {
                    <div class="mb-3 row">
                        <div class="col-8">@($"{item.FirstName} {item.LastName} — {item.JobTitle}")</div>
                        <div class="col-4">
                            <button class="btn btn-danger mb-3" @onclick=@(()=>{selectedRows = selectedRows.Except([item]);})>deselect</button>
                        </div>
                    </div>
                }
            }
        </div>
</div>

@code {
    SmGrid<Employee?>? grid;

    Employee? selectedRow = null;
    uint pageSize = 10;
    string gridWidth = "1100px";
    string gridHeight = "600px";
    string columnWidth = "150px";
    RowSelectionMode selectionMode = RowSelectionMode.Multiple;
    GridEditMode gridEditMode = GridEditMode.Form;
    GridSizeMode gridSizeMode = GridSizeMode.Small;
    GridColumnResizeMode columnResizeMode = GridColumnResizeMode.Sliding;
    IEnumerable<Employee> selectedRows = [];
    bool showDetailRow = true;
    bool showCommandBar = true;
    GridTextAlign nameAlign = GridTextAlign.Left;
    string salaryFormat = "C2";

    Task RowEditBeginHandler(Employee item)
    {
        return Task.CompletedTask;
    }

    Task RowInsertingHandler(Employee item)
    {
        employees ??= new List<Employee>();
        employees = ((new Employee[] { item }).Concat(employees)).ToList();
        return Task.CompletedTask;
    }

    Task RowsRemovingHandler(List<Employee> items)
    {
        if (employees is not null)
            employees = employees.Except(items).ToList();

        return Task.CompletedTask;
    }

    Task deselectSingleSelectedItem()
    {
        selectedRow = null;
        return Task.CompletedTask;
    }

    async Task collapseAllDetailRows() => await grid!.CollapseAllDetailRows();

    private List<Employee> employees = [];

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetEmployeesAsync(55)).ToList();
    }
}
